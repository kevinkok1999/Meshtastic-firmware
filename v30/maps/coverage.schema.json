{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeshMap Nano normalized feature JSONL",
  "type": "object",
  "required": ["id", "kind", "province", "geometry"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["boundary", "motorway", "trunk", "primary", "secondary", "tertiary", "local", "water", "place"]},
    "province": {"type": "string"},
    "name": {"type": "string"},
    "zoom_min": {"type": "integer", "minimum": 3, "maximum": 19},
    "geometry": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
  }
}
